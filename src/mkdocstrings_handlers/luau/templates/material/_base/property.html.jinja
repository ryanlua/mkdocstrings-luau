{#- A Luau property.

Context:
  property: Property object.
  root (bool)
  root_members (bool)
  heading_level (int)
  config: Rendering options.
-#}
{% block logs scoped %}
  {{ log.debug("Rendering " + property.path) }}
{% endblock logs %}

<div class="doc doc-object doc-attribute">
  {% set symbol = member_symbol|default("property") %}
  {% with obj = property, html_id = property.path %}
    {% if root %}
      {% set show_full_path = config.show_root_full_path %}
      {% set root_members = true %}
    {% elif root_members %}
      {% set show_full_path = config.show_root_members_full_path or config.show_object_full_path %}
    {% else %}
      {% set show_full_path = config.show_object_full_path %}
    {% endif %}
    {% set display_name = property.path if show_full_path else property.name %}

    {% if not root or config.show_root_heading %}
      {% filter heading(
          heading_level,
          role=symbol,
          id=html_id,
          class="doc doc-heading",
          toc_label=(('<code class="doc-symbol doc-symbol-toc doc-symbol-' ~ symbol ~ '"></code>&nbsp;')|safe if config.show_symbol_type_toc else '') ~ (config.toc_label if config.toc_label and root else property.name),
        ) %}
        {% if config.show_symbol_type_heading %}<code class="doc-symbol doc-symbol-heading doc-symbol-{{ symbol }}"></code>{% endif %}
        {% if config.heading and root %}
          {{ config.heading }}
        {% elif config.show_signature and not config.separate_signature %}
          {% filter highlight(language="luau", inline=True) %}{{ property.signature }}{% endfilter %}
        {% else %}
          <span class="doc doc-object-name doc-attribute-name">{{ display_name }}</span>
        {% endif %}
        {% with labels = property.labels %}
          {% include "labels.html.jinja" with context %}
        {% endwith %}
      {% endfilter %}
      {% if config.show_signature and config.separate_signature %}
        <div class="doc-signature">
          {% filter highlight(language="luau", inline=False) %}{{ property.signature }}{% endfilter %}
        </div>
      {% endif %}
    {% else %}
      {% if config.show_root_toc_entry %}
        {% filter heading(
            heading_level,
            role=symbol,
            id=html_id,
            hidden=True,
            toc_label=(('<code class="doc-symbol doc-symbol-toc doc-symbol-' ~ symbol ~ '"></code>&nbsp;')|safe if config.show_symbol_type_toc else '') ~ (config.toc_label if config.toc_label and root else property.name),
          ) %}
        {% endfilter %}
      {% endif %}
      {% set heading_level = heading_level - 1 %}
    {% endif %}

    <div class="doc doc-contents {% if root %}first{% endif %}">
      {% include "deprecated.html.jinja" with context %}
      {% include "description.html.jinja" with context %}
      {% if property.lua_type %}
        <p class="doc doc-property-type">
          <span class="doc-section-title">Type:</span>
          <code>
            {%- if config.signature_crossrefs -%}
              {{ property.lua_type|lua_type(property.external_types) }}
            {%- else -%}
              {{ property.lua_type }}
            {%- endif -%}
          </code>
        </p>
      {% endif %}
      {% include "source.html.jinja" with context %}
    </div>
  {% endwith %}
</div>
